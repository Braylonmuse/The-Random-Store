<section class="center-section" style="min-height: 80vh; display: flex; flex-direction: column; align-items: center; justify-content: center;">
  <div class="big-emoji">🤫</div>
  <h1>{{ shop.name }}</h1>
  <p>Something meme-worthy is loading. The store opens soon.</p>
  <div class="contact-form" style="max-width: 420px; width: 100%; text-align: left;">
    <h3>Got the password?</h3>
    {% form 'storefront_password' %}
      {%- if form.errors -%}
        <div class="form-errors">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="cf-group">
        <label for="Password">Password</label>
        <input type="password" id="Password" name="password" required>
      </div>
      <button type="submit" class="cf-submit">Enter 🔥</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "tag": "section"
}
{% endschema %}
