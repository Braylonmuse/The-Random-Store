<div class="cart-page">
  <h1>Your cart</h1>

  {%- if cart.item_count == 0 -%}
    <div class="cart-empty">
      <div class="empty-icon">🛍️</div>
      <p>Your cart is empty.<br>Plenty of random finds are waiting.</p>
      <a class="btn-dark" href="{{ routes.all_products_collection_url }}">Start shopping</a>
    </div>
  {%- else -%}
    {%- assign free_ship_cents = section.settings.free_shipping_threshold | times: 100 -%}
    {%- if section.settings.show_shipping_bar and free_ship_cents > 0 -%}
      {%- assign remaining = free_ship_cents | minus: cart.total_price -%}
      {%- assign pct = cart.total_price | times: 100 | divided_by: free_ship_cents | at_most: 100 -%}
      <div class="ship-progress-wrap">
        <div class="ship-progress-label">
          {%- if remaining > 0 -%}
            🚚 Add {{ remaining | money }} more for free US standard shipping
          {%- else -%}
            🎉 You unlocked free US standard shipping!
          {%- endif -%}
        </div>
        <div class="ship-progress-track"><div class="ship-progress-fill" style="width: {{ pct }}%;"></div></div>
      </div>
    {%- endif -%}

    <form action="{{ routes.cart_url }}" method="post">
      <div class="cart-table">
        {%- for item in cart.items -%}
          <div class="cart-line">
            {%- if item.image -%}
              {{ item.image | image_url: width: 140 | image_tag: class: 'cl-thumb', loading: 'lazy', alt: item.title }}
            {%- else -%}
              <div class="cl-thumb">👕</div>
            {%- endif -%}
            <div class="cl-info">
              <a class="cl-name" href="{{ item.url }}">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <div class="cl-sub">{{ item.variant.title }}</div>
              {%- endunless -%}
              <a class="cl-remove" href="{{ item.url_to_remove }}">Remove</a>
            </div>
            <div>
              <label class="visually-hidden" for="Qty-{{ item.index | plus: 1 }}">Quantity</label>
              <input
                class="qty-input"
                id="Qty-{{ item.index | plus: 1 }}"
                type="number"
                name="updates[]"
                value="{{ item.quantity }}"
                min="0"
              >
            </div>
            <div class="cl-price">{{ item.final_line_price | money }}</div>
          </div>
        {%- endfor -%}
      </div>

      <div class="cart-footer">
        <div class="cart-totals">
          <div class="dt-row"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></div>
          <div class="dt-row"><span>Shipping</span><span>Calculated at checkout</span></div>
          <div class="dt-row total"><span>Total</span><span>{{ cart.total_price | money }}</span></div>
          <button type="submit" class="fbtn" name="update">Update Cart</button>
          <button type="submit" class="checkout-btn" name="checkout">Checkout securely 🔒</button>
          {%- if additional_checkout_buttons -%}
            <div class="express-checkout">
              <div class="express-label"><span>or pay with</span></div>
              {{ content_for_additional_checkout_buttons }}
            </div>
          {%- endif -%}
          {%- if shop.enabled_payment_types.size > 0 -%}
            <ul class="pay-icons" aria-label="Accepted payment methods">
              {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
            </ul>
          {%- endif -%}
          <div class="trust-badges" style="justify-content:center;">
            <span>🔒 Secure checkout</span>
            <span>💬 Real support</span>
          </div>
        </div>
      </div>
    </form>
  {%- endif -%}

  {%- if section.settings.show_upsell -%}
    {%- assign up_col = section.settings.upsell_collection -%}
    {%- if up_col == blank -%}{%- assign up_col = collections.all -%}{%- endif -%}
    {%- assign max_cents = section.settings.upsell_max_price | times: 100 -%}
    {%- assign in_cart = '' -%}
    {%- for item in cart.items -%}{%- assign in_cart = in_cart | append: ',' | append: item.product_id | append: ',' -%}{%- endfor -%}
    {%- assign up_products = up_col.products | sort: 'price' -%}
    {%- capture upsell_cards -%}
      {%- assign shown = 0 -%}
      {%- for product in up_products -%}
        {%- if shown >= section.settings.upsell_limit -%}{%- break -%}{%- endif -%}
        {%- assign pid = ',' | append: product.id | append: ',' -%}
        {%- if product.available and product.price <= max_cents -%}
          {%- unless in_cart contains pid -%}
            {%- assign shown = shown | plus: 1 -%}
            <div class="upsell-card">
              <a class="upsell-thumb" href="{{ product.url }}">
                {%- if product.featured_image -%}
                  {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: product.title | escape }}
                {%- else -%}<span class="ph">🛍️</span>{%- endif -%}
              </a>
              <div class="upsell-info">
                <a class="upsell-title" href="{{ product.url }}">{{ product.title }}</a>
                <div class="upsell-price">
                  {{ product.price | money }}
                  {%- if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif -%}
                </div>
                {%- if product.has_only_default_variant -%}
                  <form action="{{ routes.cart_add_url }}" method="post">
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
                    <button type="submit" class="upsell-add">+ Add</button>
                  </form>
                {%- else -%}
                  <a class="upsell-add" href="{{ product.url }}">Choose options</a>
                {%- endif -%}
              </div>
            </div>
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if upsell_cards != blank -%}
      <section class="cart-upsell" aria-labelledby="CartUpsellHeading">
        <div class="section-head">
          <h2 id="CartUpsellHeading">{{ section.settings.upsell_heading }}</h2>
          {%- if section.settings.upsell_subtext != blank -%}<p>{{ section.settings.upsell_subtext }}</p>{%- endif -%}
        </div>
        <div class="upsell-row">{{ upsell_cards }}</div>
      </section>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart page",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_shipping_bar",
      "label": "Show free shipping progress bar",
      "default": true
    },
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "label": "Free shipping threshold",
      "default": 70
    },
    {
      "type": "header",
      "content": "You may also like"
    },
    {
      "type": "checkbox",
      "id": "show_upsell",
      "label": "Show \"You may also like\"",
      "default": true
    },
    {
      "type": "text",
      "id": "upsell_heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "text",
      "id": "upsell_subtext",
      "label": "Subtext",
      "default": "Little add-ons under $30, shipped with your order."
    },
    {
      "type": "collection",
      "id": "upsell_collection",
      "label": "Pull products from",
      "info": "Leave empty to use all products."
    },
    {
      "type": "number",
      "id": "upsell_max_price",
      "label": "Max price (USD)",
      "default": 30
    },
    {
      "type": "range",
      "id": "upsell_limit",
      "label": "How many to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}
