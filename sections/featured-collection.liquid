{%- assign col = collections[section.settings.collection] -%}
<section class="shop-section" id="shop">
  <div class="shop-header">
    <h2>{{ section.settings.heading }}</h2>
    {%- if col != blank -%}
      <span class="shop-count">{{ col.products_count }} ITEMS</span>
    {%- endif -%}
  </div>
  <div class="products">
    {%- if col != blank and col.products_count > 0 -%}
      {%- for product in col.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <div class="pcard">
          <div class="pthumb"><span class="placeholder-emoji">👕</span></div>
          <div class="pinfo">
            <span class="pname">Example product</span>
            <div class="psub">Pick a collection in the theme editor</div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
  {%- if section.settings.show_view_all and col != blank -%}
    <div style="text-align:center;margin-top:32px;">
      <a class="btn-dark" href="{{ col.url }}">View All →</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Drops"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Maximum products",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
