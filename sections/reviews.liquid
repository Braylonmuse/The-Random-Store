<section class="reviews-section">
  <div class="reviews-head">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.score_text != blank -%}
      <div class="reviews-score">★★★★★ <span>{{ section.settings.score_text }}</span></div>
    {%- endif -%}
  </div>
  <div class="reviews-grid">
    {%- for block in section.blocks -%}
      <div class="review-card" {{ block.shopify_attributes }}>
        <div class="review-stars">
          {%- for i in (1..block.settings.stars) -%}★{%- endfor -%}
        </div>
        <p>"{{ block.settings.quote }}"</p>
        <div class="review-author">
          — {{ block.settings.author }}
          {%- if block.settings.verified %} <span class="verified">✓ Verified Buyer</span>{% endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What customers are saying"
    },
    {
      "type": "text",
      "id": "score_text",
      "label": "Score text",
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Paste a real customer review here."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Customer name"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show verified badge",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Reviews"
    }
  ]
}
{% endschema %}
