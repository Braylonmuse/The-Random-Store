<section class="reviews-section">
  <div class="reviews-head">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.score_text != blank -%}
      <div class="reviews-score">★★★★★ <span>{{ section.settings.score_text }}</span></div>
    {%- endif -%}
  </div>
  <div class="reviews-grid">
    {%- for block in section.blocks -%}
      <div class="review-card" {{ block.shopify_attributes }}>
        <div class="review-stars">
          {%- for i in (1..block.settings.stars) -%}★{%- endfor -%}
        </div>
        <p>"{{ block.settings.quote }}"</p>
        <div class="review-author">
          — {{ block.settings.author }}
          {%- if block.settings.verified %} <span class="verified">✓ Verified Buyer</span>{% endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The People Have Spoken 🗣️"
    },
    {
      "type": "text",
      "id": "score_text",
      "label": "Score text",
      "default": "4.9/5 from 200+ reviews"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Quality slaps. Got 3 compliments and 1 confused look — perfect ratio."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Happy Customer"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show verified badge",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "quote": "Wore the I'm Fine tee to Thanksgiving. My aunt didn't get it. 10/10 exactly as intended.",
            "author": "Jordan T."
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "The hoodie is actually HEAVY heavy. Quality slaps. Got 3 compliments and 1 confused look — perfect ratio.",
            "author": "Maya R."
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "Ordered Tuesday, wearing it Saturday. The Moai cap goes with literally everything because it expresses nothing.",
            "author": "Dex L."
          }
        }
      ]
    }
  ]
}
{% endschema %}
