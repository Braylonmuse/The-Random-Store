<div class="page-banner">
  <h1>{{ collection.title }}</h1>
  {%- if collection.description != blank -%}
    <p>{{ collection.description | strip_html }}</p>
  {%- endif -%}
</div>

<section class="shop-section">
  <div class="shop-header">
    <h2>{{ section.settings.heading | default: 'All Products' }}</h2>
    <span class="shop-count">{{ collection.products_count }} ITEMS</span>
  </div>

  {%- paginate collection.products by section.settings.per_page -%}
    {%- if collection.products_count > 0 -%}
      <div class="products">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <div class="pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}">←</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}
              <span class="current">{{ part.title }}</span>
            {%- else -%}
              <span>{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}">→</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="cart-empty">
        <div class="empty-icon">🫥</div>
        <p>Nothing here yet.<br>The memes are coming.</p>
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Collection page",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Grid heading",
      "default": "All Products"
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 24
    }
  ]
}
{% endschema %}
