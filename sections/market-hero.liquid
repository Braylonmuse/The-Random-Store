{%- assign col = collections[section.settings.collection] -%}
<section class="mk-hero">
  <div class="page-width">
    <div class="mk-hero-card">
      <div class="mk-hero-text">
        {%- if section.settings.eyebrow != blank -%}
          <div class="mk-eyebrow"><span class="dot"></span>{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        <h1>
          {{- section.settings.heading -}}
          {%- if section.settings.heading_highlight != blank %} <em>{{ section.settings.heading_highlight }}</em>{% endif -%}
        </h1>
        {%- if section.settings.subtext != blank -%}
          <p>{{ section.settings.subtext }}</p>
        {%- endif -%}
        <div class="mk-hero-btns">
          {%- if section.settings.btn1_label != blank -%}
            <a class="btn-dark" href="{{ section.settings.btn1_link | default: routes.all_products_collection_url }}">{{ section.settings.btn1_label }}</a>
          {%- endif -%}
          {%- if section.settings.btn2_label != blank -%}
            <a class="btn-outline" href="{{ section.settings.btn2_link | default: col.url | default: routes.collections_url }}">{{ section.settings.btn2_label }}</a>
          {%- endif -%}
        </div>
        {%- if section.settings.perks != blank -%}
          <div class="mk-hero-perks">
            {%- assign perks = section.settings.perks | split: '|' -%}
            {%- for perk in perks -%}<span>{{ perk | strip }}</span>{%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="mk-hero-visual" aria-hidden="true">
        {%- if col != blank and col.products_count > 0 -%}
          {%- for product in col.products limit: 3 -%}
            <a class="mk-float mk-float-{{ forloop.index }}" href="{{ product.url }}" tabindex="-1">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'eager', alt: '' }}
              {%- else -%}
                <div class="ph">🛍️</div>
              {%- endif -%}
              <div class="mk-float-name">{{ product.title }}</div>
              <div class="mk-float-price">{{ product.price | money }}</div>
            </a>
          {%- endfor -%}
        {%- else -%}
          <div class="mk-float mk-float-1"><div class="ph">🐾</div></div>
          <div class="mk-float mk-float-2"><div class="ph">✈️</div></div>
          <div class="mk-float mk-float-3"><div class="ph">🛋️</div></div>
        {%- endif -%}
        {%- if section.settings.sticker != blank -%}
          <div class="mk-sticker">{{ section.settings.sticker }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Marketplace hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Badge text", "default": "Fresh random finds" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find something you didn't know you" },
    { "type": "text", "id": "heading_highlight", "label": "Heading highlight", "default": "needed." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Cool stuff for your home, pets, ride, and style — all in one place. Search it, find it, get it shipped." },
    { "type": "text", "id": "btn1_label", "label": "Primary button", "default": "Shop all finds" },
    { "type": "url", "id": "btn1_link", "label": "Primary button link" },
    { "type": "text", "id": "btn2_label", "label": "Secondary button", "default": "See what's trending" },
    { "type": "url", "id": "btn2_link", "label": "Secondary button link" },
    { "type": "text", "id": "perks", "label": "Perks (separate with |)", "default": "🚚 Free US shipping $70+ | 🔒 Secure checkout" },
    { "type": "collection", "id": "collection", "label": "Products shown in the hero", "info": "The first 3 products float on the right." },
    { "type": "text", "id": "sticker", "label": "Sticker text", "default": "New finds 🔥" }
  ],
  "presets": [{ "name": "Marketplace hero" }]
}
{% endschema %}
