<div class="page-banner" style="background: var(--c4);">
  <h1>{{ blog.title }}</h1>
</div>

<section class="shop-section">
  {%- paginate blog.articles by 12 -%}
    <div class="products">
      {%- for article in blog.articles -%}
        <div class="pcard">
          {%- if article.image -%}
            <a href="{{ article.url }}">
              <div class="pthumb">
                {{ article.image | image_url: width: 480 | image_tag: loading: 'lazy', alt: article.title }}
              </div>
            </a>
          {%- endif -%}
          <div class="pinfo">
            <a class="pname" href="{{ article.url }}">{{ article.title }}</a>
            <div class="psub">{{ article.published_at | date: '%b %d, %Y' }}</div>
            <p style="font-size: 12px; color: #555; line-height: 1.6;">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <div class="pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">←</a>{%- endif -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">→</a>{%- endif -%}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Blog",
  "tag": "section"
}
{% endschema %}
