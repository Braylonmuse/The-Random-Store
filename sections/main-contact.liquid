<div class="page-banner" style="background: var(--c5);">
  <h1>{{ page.title | default: 'Get In Touch' }}</h1>
  <p>Questions, collabs, or just want to send us a meme? Slide into our inbox.</p>
</div>

<section class="contact-section">
  <div class="contact-info">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    <div class="contact-methods">
      {%- for block in section.blocks -%}
        <div class="contact-method" {{ block.shopify_attributes }}>
          <span class="cm-icon">{{ block.settings.icon }}</span>
          <div>
            <div class="cm-label">{{ block.settings.label }}</div>
            <div class="cm-val">{{ block.settings.value }}</div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="contact-form">
    <h3>Send a Message</h3>
    {% form 'contact' %}
      {%- if form.posted_successfully? -%}
        <div class="nl-success">✅ Message sent! We'll reply soon.</div>
      {%- endif -%}
      {%- if form.errors -%}
        <div class="form-errors">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="cf-group">
        <label for="ContactName">Your Name</label>
        <input type="text" id="ContactName" name="contact[name]" value="{{ form.name }}">
      </div>
      <div class="cf-group">
        <label for="ContactEmail">Email</label>
        <input type="email" id="ContactEmail" name="contact[email]" value="{{ form.email }}" required>
      </div>
      <div class="cf-group">
        <label for="ContactSubject">Subject</label>
        <select id="ContactSubject" name="contact[subject]">
          <option>Order Question</option>
          <option>Wholesale Inquiry</option>
          <option>Collab / Partnership</option>
          <option>Meme Idea</option>
          <option>Something Else</option>
        </select>
      </div>
      <div class="cf-group">
        <label for="ContactMessage">Message</label>
        <textarea id="ContactMessage" name="contact[body]" rows="5">{{ form.body }}</textarea>
      </div>
      <button type="submit" class="cf-submit">Send Message 🔥</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Contact",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Let's Talk."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Whether it's an order question, a wholesale inquiry, or a meme idea — we read everything and usually reply within 24 hours."
    }
  ],
  "blocks": [
    {
      "type": "method",
      "name": "Contact method",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji icon",
          "default": "✉️"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Email"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "hey@therandomstore.com"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Contact"
    }
  ]
}
{% endschema %}
