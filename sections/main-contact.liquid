<div class="page-banner">
  <h1>{{ page.title | default: 'Get In Touch' }}</h1>
  <p>Questions about an order or a product? Send us a message or DM us.</p>
</div>

<section class="contact-section">
  <div class="contact-info">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    <div class="contact-methods">
      {%- for block in section.blocks -%}
        <div class="contact-method" {{ block.shopify_attributes }}>
          <span class="cm-icon">{{ block.settings.icon }}</span>
          <div>
            <div class="cm-label">{{ block.settings.label }}</div>
            <div class="cm-val">{%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" target="_blank" rel="noopener">{{ block.settings.value }}</a>{%- else -%}{{ block.settings.value }}{%- endif -%}</div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="contact-form">
    <h3>Send a Message</h3>
    {% form 'contact' %}
      {%- if form.posted_successfully? -%}
        <div class="nl-success">✅ Message sent! We'll reply soon.</div>
      {%- endif -%}
      {%- if form.errors -%}
        <div class="form-errors">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="cf-group">
        <label for="ContactName">Your Name</label>
        <input type="text" id="ContactName" name="contact[name]" value="{{ form.name }}">
      </div>
      <div class="cf-group">
        <label for="ContactEmail">Email</label>
        <input type="email" id="ContactEmail" name="contact[email]" value="{{ form.email }}" required>
      </div>
      <div class="cf-group">
        <label for="ContactSubject">Subject</label>
        <select id="ContactSubject" name="contact[subject]">
          <option>Order Question</option>
          <option>Wholesale Inquiry</option>
          <option>Collab / Partnership</option>
          <option>Something Else</option>
        </select>
      </div>
      <div class="cf-group">
        <label for="ContactMessage">Message</label>
        <textarea id="ContactMessage" name="contact[body]" rows="5">{{ form.body }}</textarea>
      </div>
      <button type="submit" class="cf-submit">Send message</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Contact",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We're here to help."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Whether it's an order question, a product question, or a wholesale inquiry, we read every message."
    }
  ],
  "blocks": [
    {
      "type": "method",
      "name": "Contact method",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji icon",
          "default": "✉️"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Email"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "@ustherandom"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Contact"
    }
  ]
}
{% endschema %}
