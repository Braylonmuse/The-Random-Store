<section class="why-section">
  <h2>{{ section.settings.heading }}</h2>
  <div class="why-grid">
    {%- for block in section.blocks -%}
      <div class="why-card" {{ block.shopify_attributes }}>
        <div class="why-icon">{{ block.settings.icon }}</div>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Why shop here",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop with confidence"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji icon",
          "default": "🚚"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free US shipping at $70"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Standard shipping is free on US orders of $70 or more."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Why shop here",
      "blocks": [
        { "type": "card", "settings": { "icon": "🚚", "title": "Free US shipping at $70", "text": "Standard shipping is free on US orders of $70 or more." } },
        { "type": "card", "settings": { "icon": "🔒", "title": "Secure checkout", "text": "Pay safely through Shopify's encrypted checkout." } },
        { "type": "card", "settings": { "icon": "💬", "title": "Real people on support", "text": "Message us from the contact page and a real person gets back to you." } }
      ]
    }
  ]
}
{% endschema %}
