<footer class="site-footer">
  <div class="page-width">
  <div class="footer-grid">
    <div class="footer-brand">
      <a class="logo" href="{{ routes.root_url }}"><span class="logo-the">the</span><span class="logo-word">random</span><span class="logo-store">store</span></a>
      <p>{{ section.settings.blurb }}</p>
    </div>
    {%- for block in section.blocks -%}
      <div class="footer-col" {{ block.shopify_attributes }}>
        <h4>{{ block.settings.heading }}</h4>
        {%- for link in block.settings.menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
  <div class="footer-bottom">
    <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
    <div class="footer-socials">
      {%- if settings.social_instagram != blank -%}
        <a class="fsoc" href="{{ settings.social_instagram }}" aria-label="Instagram">📸</a>
      {%- endif -%}
      {%- if settings.social_tiktok != blank -%}
        <a class="fsoc" href="{{ settings.social_tiktok }}" aria-label="TikTok">🎵</a>
      {%- endif -%}
      {%- if settings.social_twitter != blank -%}
        <a class="fsoc" href="{{ settings.social_twitter }}" aria-label="Twitter / X">🐦</a>
      {%- endif -%}
      {%- if settings.social_youtube != blank -%}
        <a class="fsoc" href="{{ settings.social_youtube }}" aria-label="YouTube">▶️</a>
      {%- endif -%}
    </div>
  </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Brand blurb",
      "default": "Random finds for your home, pets, ride, and style. Browse something new, check out securely, and get it shipped to your door."
    }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
