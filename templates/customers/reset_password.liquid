<div class="account-page">
  <h1>Reset Password 🔒</h1>
  <div class="account-card" style="max-width: 480px;">
    {% form 'reset_customer_password' %}
      {%- if form.errors -%}
        <div class="form-errors">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="cf-group">
        <label for="ResetPassword">New password</label>
        <input type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="cf-group">
        <label for="ResetPasswordConfirm">Confirm new password</label>
        <input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="cf-submit">Reset Password</button>
    {% endform %}
  </div>
</div>
