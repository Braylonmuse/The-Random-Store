<div class="account-page">
  <h1>Log In 🔑</h1>
  <div class="account-card" style="max-width: 480px;">
    {% form 'customer_login' %}
      {%- if form.errors -%}
        <div class="form-errors">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="cf-group">
        <label for="CustomerEmail">Email</label>
        <input type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" required>
      </div>
      <div class="cf-group">
        <label for="CustomerPassword">Password</label>
        <input type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password" required>
      </div>
      <button type="submit" class="cf-submit">Log In 🔥</button>
      <p style="margin-top: 14px; font-size: 12px;">
        <a class="form-link" href="#recover" onclick="document.getElementById('RecoverForm').style.display='block';return false;">Forgot password?</a>
        · <a class="form-link" href="{{ routes.account_register_url }}">Create account</a>
      </p>
    {% endform %}
  </div>

  <div class="account-card" id="RecoverForm" style="max-width: 480px; margin-top: 24px; display: none;">
    <h3>Reset your password</h3>
    {% form 'recover_customer_password' %}
      {%- if form.posted_successfully? -%}
        <p style="font-size: 12px;">✅ Check your email for a reset link.</p>
      {%- endif -%}
      {%- if form.errors -%}
        <div class="form-errors">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="cf-group">
        <label for="RecoverEmail">Email</label>
        <input type="email" id="RecoverEmail" name="email" autocomplete="email" required>
      </div>
      <button type="submit" class="cf-submit">Send Reset Link</button>
    {% endform %}
  </div>
</div>
