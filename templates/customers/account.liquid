<div class="account-page">
  <h1>Your Account 👤</h1>
  <p style="font-size: 12px; margin-bottom: 8px;">
    Logged in as {{ customer.email }} ·
    <a class="form-link" href="{{ routes.account_logout_url }}">Log out</a> ·
    <a class="form-link" href="{{ routes.account_addresses_url }}">Addresses ({{ customer.addresses_count }})</a>
  </p>

  <h2>Order History</h2>
  {%- if customer.orders.size > 0 -%}
    {%- paginate customer.orders by 20 -%}
      <table class="order-table">
        <thead>
          <tr><th>Order</th><th>Date</th><th>Payment</th><th>Fulfillment</th><th>Total</th></tr>
        </thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr>
              <td><a class="form-link" href="{{ order.customer_url }}">{{ order.name }}</a></td>
              <td>{{ order.created_at | date: '%b %d, %Y' }}</td>
              <td>{{ order.financial_status_label }}</td>
              <td>{{ order.fulfillment_status_label }}</td>
              <td>{{ order.total_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- endpaginate -%}
  {%- else -%}
    <p style="font-size: 12px;">No orders yet. <a class="form-link" href="{{ routes.all_products_collection_url }}">Fix that →</a></p>
  {%- endif -%}
</div>
